    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
